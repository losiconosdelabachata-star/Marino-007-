# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored for a reason.

# Claude AI (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Shopify Admin API
SHOPIFY_STORE=losiconosdelabachata.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_PASSWORD=

# Printify
PRINTIFY_SHOP_ID=
PRINTIFY_API_KEY=

# WhatsApp bridge
WHATSAPP_SERVER_URL=http://localhost:3000
MARINO_PHONE=

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Photos & Drive (OAuth client secret files, also gitignored)
GOOGLE_PHOTOS_CREDENTIALS=google_photos_credentials.json
GOOGLE_DRIVE_CREDENTIALS=google_drive_credentials.json

# Email blasts
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Web search (blank = free DuckDuckGo)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Blog engine
BLOG_OUTPUT_DIR=blogs
BLOG_POSTS_PER_DAY=1
BLOG_SCHEDULE_HOUR=9
BLOG_SCHEDULE_MINUTE=0

# Bot identity
BOT_OWNER=Marino Santos
BOT_NAME=Marino 007
BOT_BRAND=Los Iconos de la Bachata
