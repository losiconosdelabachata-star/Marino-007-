# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored for a reason.

# Claude AI (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Shopify Admin API
SHOPIFY_STORE=losiconosdelabachata.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_PASSWORD=

# Printify
PRINTIFY_SHOP_ID=
PRINTIFY_API_KEY=

# WhatsApp bridge (3010 avoids the other local Next.js projects on 3000-3004)
WHATSAPP_SERVER_URL=http://localhost:3010
WHATSAPP_PORT=3010
MARINO_PHONE=

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Photos & Drive - LOCAL: OAuth client secret files (gitignored).
# The interactive consent flow caches a token beside them on first run.
GOOGLE_PHOTOS_CREDENTIALS=google_photos_credentials.json
GOOGLE_DRIVE_CREDENTIALS=google_drive_credentials.json

# Google Photos & Drive - DEPLOYED: a server has no browser and can never
# complete Google's consent screen, so it needs refresh tokens instead.
# Generate them locally with: python get_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PHOTOS_REFRESH_TOKEN=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Where mutable state is written. Unset locally (defaults to the project
# folder); set to the mounted volume in a container.
# DATA_DIR=/data

# Set in containers to fail fast instead of trying to open a browser.
# HEADLESS=1

# Email blasts
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Web search (blank = free DuckDuckGo)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Blog engine
BLOG_OUTPUT_DIR=blogs
BLOG_POSTS_PER_DAY=1
BLOG_SCHEDULE_HOUR=9
BLOG_SCHEDULE_MINUTE=0

# Bot identity
BOT_OWNER=Marino Santos
BOT_NAME=Marino 007
BOT_BRAND=Los Iconos de la Bachata
