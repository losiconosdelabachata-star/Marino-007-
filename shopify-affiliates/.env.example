# Copy to .env.local and fill in. .env.local is gitignored.

# Required. The dashboard refuses to serve without this - it can publish
# blog posts, email customers, and expose the WhatsApp pairing QR.
# Generate one: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
DASHBOARD_PASSWORD=

# Signs the session cookie. Falls back to DASHBOARD_PASSWORD if unset.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Shopify Admin API
SHOPIFY_STORE=losiconosdelabachata.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_PASSWORD=

# Where the Baileys WhatsApp bridge listens
WHATSAPP_SERVER_URL=http://localhost:3000

# Gmail account used for affiliate notification emails
EMAIL_SENDER=
EMAIL_PASSWORD=
